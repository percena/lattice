# Optional: auto-add skill-created GitHub issues/PRs to a Project.
# Copy to .env (gitignored) and fill both OWNER + NUMBER to enable.
# Requires: gh auth refresh -s project
#
# Multiple repos can point at the same project (one board, many repos).
# Skills only add items they create — web UI creates are not forced.
#
# Example: OWNER=your-org NUMBER=42

LATTICE_GITHUB_PROJECT_OWNER=
LATTICE_GITHUB_PROJECT_NUMBER=

# Optional (default true when project is enabled):
# LATTICE_GITHUB_PROJECT_ADD_ISSUES=true
# LATTICE_GITHUB_PROJECT_ADD_PRS=true

# A repository file cannot authorize writing to an EXTERNAL (org/other-owner)
# board: if the target below comes from this file rather than your shell
# environment, the add is SKIPPED for non-self owners. Set this to trust the .env
# of a repository you control.
# LATTICE_GITHUB_PROJECT_ALLOW_DOTENV=1
#
# Self-board auto-trust: when OWNER below equals the authenticated `gh` user
# (your OWN board), the add proceeds WITHOUT the opt-in above — a self board is
# inherently non-abusable, so single-user setups need no extra shell config.
# Org boards (OWNER = an org, not your login) still require the opt-in above.
