# Optional: auto-add skill-created GitHub issues/PRs to a Project.
# Copy to .env (gitignored) and fill both OWNER + NUMBER to enable.
# Requires: gh auth refresh -s project
#
# Multiple repos can point at the same project (one board, many repos).
# Skills only add items they create — web UI creates are not forced.
#
# Example: OWNER=your-org NUMBER=42

LATTICE_GITHUB_PROJECT_OWNER=
LATTICE_GITHUB_PROJECT_NUMBER=

# Optional (default true when project is enabled):
# LATTICE_GITHUB_PROJECT_ADD_ISSUES=true
# LATTICE_GITHUB_PROJECT_ADD_PRS=true

# A repository file cannot authorize writing to an external board: if the target
# below comes from this file rather than your shell environment, the add is
# SKIPPED. Set this to trust the .env of a repository you control.
# LATTICE_GITHUB_PROJECT_ALLOW_DOTENV=1
